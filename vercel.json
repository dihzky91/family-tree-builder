{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/submit/:branchCode",
      "destination": "/api/og-html?type=submit&code=:branchCode"
    },
    {
      "source": "/view/:shareCode",
      "destination": "/api/og-html?type=view&code=:shareCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
